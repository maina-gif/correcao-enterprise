<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wayne.wayneen.enterpriseswyne.controller.ConfiguracoesController"
      spacing="10" alignment="TOP_CENTER" prefWidth="600" prefHeight="400" style="-fx-padding: 20;">

    <Label text="Configurações Administrativas" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <TextField fx:id="campoChave" promptText="Chave"/>
        <TextField fx:id="campoValor" promptText="Valor"/>
        <Button text="Salvar" onAction="#salvarConfiguracao"/>
    </HBox>

    <TableView fx:id="tabelaConfiguracoes" prefHeight="300">
        <columns>
            <TableColumn fx:id="colChave" text="Chave" prefWidth="200"/>
            <TableColumn fx:id="colValor" text="Valor" prefWidth="300"/>
        </columns>
    </TableView>
</VBox>