<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wayne.wayneen.enterpriseswyne.controller.EstoqueController"
            prefWidth="600" prefHeight="400">
    <children>
        <VBox spacing="15" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Adicionar/Editar Item" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

            <GridPane hgap="10" vgap="10">
                <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="campoNome" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Quantidade:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="campoQuantidade" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Descrição:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="campoDescricao" GridPane.rowIndex="2" GridPane.columnIndex="1" />
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Salvar" onAction="#adicionarItem" />
                <Button text="Remover" onAction="#removerItem" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>