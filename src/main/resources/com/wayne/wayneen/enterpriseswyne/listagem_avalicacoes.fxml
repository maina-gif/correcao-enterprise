<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wayne.wayneen.enterpriseswyne.ListarAvaliacoesController"
            prefWidth="800.0" prefHeight="600.0">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">

            <padding>
                <Insets top="15" bottom="15" left="15" right="15" />
            </padding>

            <Label text="Listagem de Avaliações de Desempenho"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <!-- Filtros -->
            <HBox spacing="10">
                <TextField fx:id="filtroFuncionarioField" promptText="ID do Funcionário" />
                <DatePicker fx:id="filtroDataInicial" promptText="Data Inicial" />
                <DatePicker fx:id="filtroDataFinal" promptText="Data Final" />
                <Button text="Filtrar" onAction="#carregarAvaliacoes" />
            </HBox>

            <!-- Tabela -->
            <TableView fx:id="tabelaAvaliacoes" prefHeight="500">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colFuncionarioId" text="Funcionário ID" prefWidth="100"/>
                    <TableColumn fx:id="colData" text="Data" prefWidth="100"/>
                    <TableColumn fx:id="colPontualidade" text="Pontualidade" prefWidth="100"/>
                    <TableColumn fx:id="colProdutividade" text="Produtividade" prefWidth="100"/>
                    <TableColumn fx:id="colTrabalhoEquipe" text="Trabalho Equipe" prefWidth="120"/>
                    <TableColumn fx:id="colObservacoes" text="Observações" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
