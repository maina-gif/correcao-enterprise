<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wayne.wayneen.enterpriseswyne.controller.LogAuditoriaController">

    <top>
        <Label text="📋 Histórico de Ações do Sistema"
               style="-fx-font-size: 18px; -fx-padding: 10;" />
    </top>

    <center>
        <TableView fx:id="tabelaLogs" prefHeight="400">
            <columns>
                <TableColumn fx:id="colUsuario" text="Usuário" prefWidth="150"/>
                <TableColumn fx:id="colAcao" text="Ação" prefWidth="250"/>
                <TableColumn fx:id="colModulo" text="Módulo" prefWidth="150"/>
                <TableColumn fx:id="colDataHora" text="Data e Hora" prefWidth="180"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Fechar" onAction="#fechar"/>
        </HBox>
    </bottom>
</BorderPane>
