<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.wayne.wayneen.enterpriseswyne.controller.PlanoCargosController">
    <top>
        <Label text="📊 Plano de Cargos" style="-fx-font-size: 18px; -fx-padding: 10;" />
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="10">
                <TextField fx:id="campoNome" promptText="Nome do Cargo"/>
                <TextField fx:id="campoSalario" promptText="Salário Base (R$)"/>
                <ComboBox fx:id="comboNivel" promptText="Nível"/>
            </HBox>

            <HBox spacing="10">
                <Button text="Salvar" onAction="#salvar"/>
                <Button text="Atualizar" onAction="#atualizar"/>
                <Button text="Excluir" onAction="#excluir"/>
                <Button text="Limpar" onAction="#limparCampos"/>
            </HBox>

            <TableView fx:id="tabelaCargos" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colId" text="ID"/>
                    <TableColumn fx:id="colNome" text="Nome"/>
                    <TableColumn fx:id="colSalario" text="Salário Base"/>
                    <TableColumn fx:id="colNivel" text="Nível"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
