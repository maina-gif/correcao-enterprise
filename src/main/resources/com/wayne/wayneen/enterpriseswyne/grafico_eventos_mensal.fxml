<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.XYChart?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wayne.wayneen.enterpriseswyne.controller.GraficoEventosMensalController"
            prefWidth="700" prefHeight="500">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <Label text="Eventos por Mês"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <BarChart fx:id="graficoBarra" prefHeight="450">
                <xAxis>
                    <CategoryAxis fx:id="eixoX" label="Mês"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="eixoY" label="Quantidade de Eventos"/>
                </yAxis>
            </BarChart>
        </VBox>
    </children>
</AnchorPane>
