<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="589.0" prefWidth="841.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wayne.wayneen.enterpriseswyne.controller.HomeController">

   <children>
      <Pane prefHeight="705.0" prefWidth="842.0">
         <children>
            <ImageView fitHeight="421.0" fitWidth="496.0" layoutX="183.0" layoutY="20.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@logo/logo 1.png" />
               </image>
            </ImageView>

            <Button layoutX="289.0" layoutY="423.0" mnemonicParsing="false" onAction="#abrirLogin" prefHeight="53.0" prefWidth="208.0" text="Login">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <ButtonBar layoutX="183.0" layoutY="32.0" prefHeight="40.0" prefWidth="200.0" />
            <MenuButton layoutX="14.0" layoutY="20.0" mnemonicParsing="false" text="Sobre">
              <items>
                <MenuItem mnemonicParsing="false" text="Sobre a Empresa" onAction="#abrirSobreEmpresa" />
                <MenuItem mnemonicParsing="false" text="Sobre (Dialogo)" onAction="#abrirSobreDialog" />
              </items>
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </MenuButton>
         </children>
      </Pane>
   </children>
</VBox>
