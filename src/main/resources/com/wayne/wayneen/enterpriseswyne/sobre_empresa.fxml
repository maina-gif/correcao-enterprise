<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wayne.wayneen.enterpriseswyne.controller.SobreEmpresaController">
    <top>
        <Label text="🏢 Sobre a Empresa" style="-fx-font-size:18px; -fx-padding:10;"/>
    </top>

    <center>
        <SplitPane dividerPositions="0.36">
            <!-- Lado esquerdo: formulário -->
            <ScrollPane fitToWidth="true">
                <content>
                    <VBox spacing="10">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                        <TitledPane text="Identificação" expanded="true">
                            <content>
                                <GridPane hgap="10" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="30"/>
                                        <ColumnConstraints percentWidth="70"/>
                                    </columnConstraints>
                                    <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="nomeField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                    <Label text="CNPJ:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextField fx:id="cnpjField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                    <Label text="Telefone:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <TextField fx:id="telefoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                    <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                    <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                    <Label text="Site:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                    <TextField fx:id="siteField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                    <Label text="Endereço:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                    <TextArea fx:id="enderecoArea" prefRowCount="2" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                    <Label text="Redes sociais (texto):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                                    <TextArea fx:id="redesArea" prefRowCount="2" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                                </GridPane>
                            </content>
                        </TitledPane>

                        <TitledPane text="Missão, Visão e Valores" expanded="false">
                            <content>
                                <GridPane hgap="10" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="30"/>
                                        <ColumnConstraints percentWidth="70"/>
                                    </columnConstraints>
                                    <Label text="Missão:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextArea fx:id="missaoArea" prefRowCount="2" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                    <Label text="Visão:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextArea fx:id="visaoArea" prefRowCount="2" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                    <Label text="Valores:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <TextArea fx:id="valoresArea" prefRowCount="2" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                </GridPane>
                            </content>
                        </TitledPane>

                        <TitledPane text="Logo" expanded="false">
                            <content>
                                <VBox spacing="8">
                                    <ImageView fx:id="logoView" fitWidth="260" preserveRatio="true" />
                                    <HBox spacing="8">
                                        <Button text="Escolher logo" onAction="#escolherLogo"/>
                                        <Button text="Abrir logo" onAction="#abrirLogo"/>
                                        <Button text="Remover logo" onAction="#removerLogo"/>
                                    </HBox>
                                </VBox>
                            </content>
                        </TitledPane>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Lado direito: editor + preview -->
            <SplitPane orientation="VERTICAL" dividerPositions="0.55">
                <VBox>
                    <Label text="Descrição (HTML)" style="-fx-padding:6;"/>
                    <HTMLEditor fx:id="htmlEditor" prefHeight="300" />
                </VBox>
                <VBox>
                    <Label text="Preview" style="-fx-padding:6;"/>
                    <WebView fx:id="webPreview" prefHeight="250" />
                </VBox>
            </SplitPane>
        </SplitPane>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Button text="Salvar" onAction="#salvar"/>
            <Button text="Recarregar" onAction="#recarregar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="atualizadoLabel" text=""/>
            <Button text="Fechar" onAction="#fechar"/>
        </HBox>
    </bottom>
</BorderPane>