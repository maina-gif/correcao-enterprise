<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wayne.wayneen.enterpriseswyne.controller.CurriculoFormController">
    <top>
        <Label text="➕ Cadastro de Currículo" style="-fx-font-size:18px; -fx-padding:10;" />
    </top>

    <center>
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="75"/>
            </columnConstraints>

            <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nomeField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Telefone:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="telefoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Cargo desejado:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="cargoField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Escolaridade:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="escolaridadeField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="LinkedIn:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="linkedinField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Status:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <ComboBox fx:id="statusBox" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            <Label text="Skills (; separadas):" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
            <TextArea fx:id="skillsArea" prefRowCount="2" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

            <Label text="Experiência (resumo):" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
            <TextArea fx:id="experienciaArea" prefRowCount="4" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

            <Label text="Currículo (PDF):" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
            <HBox spacing="8" GridPane.rowIndex="9" GridPane.columnIndex="1">
                <TextField fx:id="pdfPathField" promptText="Selecione o arquivo..." editable="false" HBox.hgrow="ALWAYS"/>
                <Button text="Escolher" onAction="#escolherPdf"/>
                <Button text="Abrir" onAction="#abrirPdf"/>
            </HBox>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Salvar" onAction="#salvar"/>
            <Button text="Limpar" onAction="#limpar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Fechar" onAction="#fechar"/>
        </HBox>
    </bottom>
</BorderPane>
