<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.wayne.wayneen.enterpriseswyne.controller.BeneficioController">
    <top>
        <Label text="💼 Controle de Benefícios" style="-fx-font-size: 18px; -fx-padding: 10;" />
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="10">
                <TextField fx:id="campoTipo" promptText="Tipo de Benefício" />
                <TextField fx:id="campoValor" promptText="Valor (R$)" />
            </HBox>

            <HBox spacing="10">
                <Button text="Salvar" onAction="#salvar"/>
                <Button text="Atualizar" onAction="#atualizar"/>
                <Button text="Excluir" onAction="#excluir"/>
                <Button text="Limpar" onAction="#limparCampos"/>
            </HBox>

            <TableView fx:id="tabelaBeneficios" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colId" text="ID"/>
                    <TableColumn fx:id="colTipo" text="Tipo"/>
                    <TableColumn fx:id="colValor" text="Valor (R$)"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
